---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ '/' | absolute_url }}</loc>
    {% assign homepage = site.pages | where: 'name', 'index.md' | first %}
    {% if homepage.last_modified_at %}<lastmod>{{ homepage.last_modified_at | date: '%Y-%m-%d' }}</lastmod>{% endif %}
  </url>
  {% for file in site.static_files %}
  {% if file.path contains '/file/papers/' and file.extname == '.pdf' %}
  <url>
    <loc>{{ file.path | absolute_url | uri_escape | xml_escape }}</loc>
  </url>
  {% endif %}
  {% endfor %}
</urlset>
